<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OCRエンジン（Tesseract / PP-OCRv6 small / medium）の精度・速度を比較するための開発用ツールです。
    ソリューションには含めず、パッケージにも含まれません。使い方は README.md を参照してください。
    A development tool that compares the accuracy and speed of OCR engines. It is not part of the
    solution or the package. See README.md for usage.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProjectAnalyzer.Core\ProjectAnalyzer.Core.csproj" />
  </ItemGroup>

</Project>
